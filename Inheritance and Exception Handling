class Person {
    String name; int age;
    Person(String n, int a) { name = n; age = a; }
    void display() { System.out.print("Name: " + name + ", Age: " + age); }
}

// Single: Person -> Student
class Student extends Person {
    String course; int roll;
    Student(String n, int a, String c, int r) { super(n, a); course = c; roll = r; }
    void display() { super.display(); System.out.print(", Course: " + course + ", Roll: " + roll); }
}

// Multilevel: Person -> Student -> GraduateStudent
class GraduateStudent extends Student {
    int gradYear;
    GraduateStudent(String n, int a, String c, int r, int g) { super(n, a, c, r); gradYear = g; }
    void display() { super.display(); System.out.print(", Graduation Year: " + gradYear); }
}

// Hierarchical: Person -> Teacher and Person -> Administrator
class Teacher extends Person {
    String subject;
    Teacher(String n, int a, String s) { super(n, a); subject = s; }
    void display() { super.display(); System.out.print(", Subject: " + subject); }
}

class Administrator extends Person {
    String dept;
    Administrator(String n, int a, String d) { super(n, a); dept = d; }
    void display() { super.display(); System.out.print(", Department: " + dept); }
}

public class InheritanceDemo {
    static void check(int age) throws Exception {                    // throws
        if (age < 0) throw new Exception("Age cannot be negative");  // throw
    }

    public static void main(String[] args) {
        try {                                                        // try
            Person[] p = {
                new Person("Ravi", 40),
                new Student("Amit", 19, "AI&DS", 101),
                new GraduateStudent("Neha", 22, "AI&DS", 201, 2026),
                new Teacher("Sharma", 45, "Java"),
                new Administrator("Joshi", 38, "Accounts")
            };
            for (Person x : p) { check(x.age); x.display(); System.out.println(); }
            check(-5);                                               // triggers the exception
        } catch (Exception e) {                                      // catch
            System.out.println("Error: " + e.getMessage());
        } finally {                                                  // finally
            System.out.println("Finally block executed");
        }
    }
}
