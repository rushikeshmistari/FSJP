class Calculator {

    Calculator() {
        System.out.println("Welcome to the Calculator!");
    }

    Calculator(int a, int b) {
        System.out.println("Parameterized constructor: " + a + " + " + b + " = " + (a + b));
    }

    void add() {
        int a = 5, b = 10;
        System.out.println("add() with no parameters : " + a + " + " + b + " = " + (a + b));
    }

    void add(int a, int b) {
        System.out.println("add(int, int)            : " + a + " + " + b + " = " + (a + b));
    }

    void add(float a, float b, float c) {
        System.out.println("add(float, float, float) : " + a + " + " + b + " + " + c + " = " + (a + b + c));
    }
}

public class CalculatorDemo {
    public static void main(String[] args) {

        System.out.println("--- Using default constructor ---");
        Calculator c1 = new Calculator();

        System.out.println("\n--- Using parameterized constructor ---");
        Calculator c2 = new Calculator(20, 30);

        System.out.println("\n--- Calling overloaded add() methods ---");
        c1.add();                    
        c1.add(12, 8);               
        c2.add(1.5f, 2.5f, 3.0f);     
    }
}
